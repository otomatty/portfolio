{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Serve the prerendered 404.html for unknown paths (Pages did this implicitly).
		"not_found_handling": "404-page"
	},
	// Production is served only on the custom domain. Cloudflare creates the
	// DNS record and certificate on deploy; the domain must not still be
	// attached to a Pages project.
	"routes": [
		{ "pattern": "saedgewell.com", "custom_domain": true }
	],
	"workers_dev": false,
	// Keep workers.dev Preview URLs (Worker Previews created by Workers Builds
	// for non-production branches) even though the production workers.dev
	// route is disabled.
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
