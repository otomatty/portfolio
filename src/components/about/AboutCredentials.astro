---
import Section from '@/components/common/Section.astro';
import { certificationGroups } from '@/data/profile';
---

<Section id="credentials-title" label="Credentials" title="資格・受賞歴">
  <div class="grid grid-cols-[minmax(0,1fr)] gap-14 md:grid-cols-2 md:gap-12">
    {certificationGroups.map((group) => (
      <div>
        <h3 class="mb-2 text-[13px] tracking-[0.14em] text-gold">{group.title}</h3>
        <ul>
          {group.items.map((item) => (
            <li class="grid gap-1.5 border-t py-5 first:border-t-0">
              <p class="text-[12px] tracking-[0.08em] text-muted-foreground">{item.date}</p>
              <p class="text-[15.5px] tracking-[0.04em]">{item.title}</p>
              <p class="text-[13.5px] leading-relaxed text-muted-foreground">{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
