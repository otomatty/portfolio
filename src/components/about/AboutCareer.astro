---
import MoreLink from '@/components/common/MoreLink.astro';
import Section from '@/components/common/Section.astro';
import Timeline, { type TimelineEntry, type TimelineRow } from '@/components/common/Timeline.astro';
import { careerEntries, type CareerEntry, type CareerGroup, type CareerHighlight } from '@/data/profile';
import { formatImpactText, formatWorkPeriod, getHeadlineImpact, getImpactOf, getWorkBySlug } from '@/data/works';

interface Props {
  /** 経歴ページでは仕事ごとの行と成果まで載せ、About では要約と代表的な成果だけにする */
  detailed?: boolean;
  title?: string;
}

const { detailed = false, title = '経歴' } = Astro.props;

/** まとまりの行を作る。実績は題名・期間・要約・見出しの数値を実績データから引く */
const rowsOf = (group: CareerGroup): TimelineRow[] => [
  ...(group.works ?? []).map((slug) => {
    const work = getWorkBySlug(slug);
    if (!work) throw new Error(`経歴が参照する実績 ${slug} がありません`);
    return {
      title: work.subtitle ? `${work.title} — ${work.subtitle}` : work.title,
      href: `/works/${work.slug}`,
      meta: `${formatWorkPeriod(work.period)} · ${work.description}`,
      impact: getHeadlineImpact(work),
    };
  }),
  ...(group.rows ?? []),
];

const countOf = (group: CareerGroup) => (group.works?.length ?? 0) + (group.rows?.length ?? 0);

/** 要約が無い経歴は、まとまりごとの件数から作る（例: 客先案件 3 件・社内ツール 4 件） */
const summaryOf = (entry: CareerEntry) =>
  entry.summary ??
  entry.groups.map((group) => `${group.label ? `${group.label} ` : ''}${countOf(group)} 件`).join('・');

/** 代表的な成果の1行。実績の数値は実績データから引く */
const highlightText = (item: CareerHighlight) =>
  typeof item === 'string' ? item : `${item.label} ${formatImpactText(getImpactOf(item.slug, item.index))}`;

const entries: TimelineEntry[] = careerEntries.map((entry) => ({
  period: entry.period,
  kicker: entry.company,
  title: entry.title,
  description: detailed ? entry.description : summaryOf(entry),
  highlights: detailed ? undefined : entry.highlights.map(highlightText),
  groups: detailed ? entry.groups.map((group) => ({ label: group.label, rows: rowsOf(group) })) : undefined,
  highlight: entry.current,
}));
---

<Section id="career-title" label="Career" title={title}>
  <Timeline entries={entries} />
  {!detailed && <MoreLink href="/about/career" label="経歴の詳細" class="mt-12" />}
</Section>
