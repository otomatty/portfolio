---
import MoreLink from '@/components/common/MoreLink.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import { getTechStacks } from '@/lib/skills/selectors';

const techStacks = getTechStacks();
---

<section class="border-b py-20 md:py-28" aria-labelledby="stack-title">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionHeading id="stack-title" label="Stack" title="技術スタック" description="実務で使っている技術です。" />

    <dl class="border-b">
      {techStacks.map((stack) => (
        <div class="grid grid-cols-[minmax(0,1fr)] gap-3 border-t py-6 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10">
          <dt class="text-[13px] tracking-[0.1em] text-gold">{stack.category}</dt>
          <dd>
            <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[14.5px] tracking-[0.04em]">
              {stack.technologies.map((tech) => <li>{tech}</li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
      <MoreLink href="/about/skills" label="スキルの詳細" />
      <MoreLink href="/about/skill-sheet" label="スキルシート" />
    </div>
  </div>
</section>
