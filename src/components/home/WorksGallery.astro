---
import SectionLabel from '@/components/common/SectionLabel.astro';
import { homepageCopy } from '@/data/homepage';
import { WORK_KIND_LABELS, formatWorkNumber } from '@/data/works';
import type { Work } from '@/types/works';

/**
 * 実績の「展示室」。代表作を1画面に1件ずつ見せ、残りは最後に一覧で並べる。
 * 背面の年号・画像・文字の動く量を変えて奥行きを出す（data-parallax）。
 */
interface Props {
  featured: Work[];
  others: Work[];
  /** 作成日順の通し番号（slug → No.） */
  numbers: Record<string, number>;
}

const { featured, others, numbers } = Astro.props;
const { works: copy } = homepageCopy;
const yearMonth = (iso: string) => iso.slice(0, 7).replace('-', '.');
const no = (work: Work) => formatWorkNumber(numbers[work.slug]);
---

<section id="works" class="relative scroll-mt-16 border-b py-20 md:py-32" aria-labelledby="works-title">
  <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid justify-items-start gap-5">
      <SectionLabel text={copy.label} />
      <h2 id="works-title" class="section-title">{copy.title}</h2>
    </div>

    <div class="gallery">
      <nav class="gallery-index" aria-label={copy.indexLabel}>
        <ol>
          {
            featured.map((work, i) => (
              <li>
                <a href={`#work-${work.slug}`} data-gallery-link={i}>
                  {work.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#works-others" data-gallery-link={featured.length}>
              {copy.othersIndex} {others.length}件
            </a>
          </li>
        </ol>
      </nav>

      <div>
        {
          featured.map((work, i) => (
            <article class:list={['scene', { reverse: i % 2 === 1 }]} id={`work-${work.slug}`} data-gallery-scene={i}>
              <span class="scene-year" data-parallax="0.24" aria-hidden="true">
                {work.created_at.slice(0, 4)}
              </span>
              <figure class="scene-figure">
                <div class="scene-image" data-parallax="0.08">
                  <img
                    src={work.thumbnail}
                    alt={`${work.title} の画面`}
                    width="3360"
                    height="1856"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </figure>
              <div class="scene-caption">
                <p class="work-meta">
                  <span>{no(work)}</span>
                  <span class:list={['kind', `kind-${work.kind}`]}>
                    <i />
                    {WORK_KIND_LABELS[work.kind]}
                  </span>
                  <span>{yearMonth(work.created_at)}</span>
                </p>
                <h3 class="scene-title">{work.title}</h3>
                <p class="max-w-[34em] text-sm text-muted-foreground">{work.description}</p>
                <p class="text-xs tracking-[0.08em] text-muted-foreground">{work.technologies.join(' · ')}</p>
                <p class="flex flex-wrap gap-x-6 gap-y-1 text-[13px] tracking-[0.06em]">
                  <a href={`/works/${work.slug}`} class="py-1.5 transition-colors hover:text-gold">
                    {copy.viewDetail} →
                  </a>
                  {work.website_url && (
                    <a href={work.website_url} target="_blank" rel="noopener noreferrer" class="py-1.5 transition-colors hover:text-gold">
                      {copy.website} ↗
                    </a>
                  )}
                </p>
              </div>
            </article>
          ))
        }

        <section id="works-others" class="others" data-gallery-scene={featured.length} aria-labelledby="works-others-title">
          <h3 id="works-others-title" class="others-title">{copy.others}</h3>
          <ol>
            {
              others.map((work) => (
                <li>
                  <a href={`/works/${work.slug}`} class="other-row">
                    <span class="other-no">{no(work)}</span>
                    <span class="other-title">{work.title}</span>
                    <span class:list={['other-kind', 'kind', `kind-${work.kind}`]}>
                      <i />
                      {WORK_KIND_LABELS[work.kind]}
                    </span>
                    <span class="other-date">{yearMonth(work.created_at)}</span>
                    <span class="other-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <a href="/works" class="group mt-8 inline-flex items-center gap-3 text-[14.5px] tracking-[0.08em] transition-colors hover:text-gold">
            {copy.viewAll}
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  // 今見ている展示を目次で示す
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery-link]'));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const index = (entry.target as HTMLElement).dataset.galleryScene;
        links.forEach((link) => link.classList.toggle('is-active', link.dataset.galleryLink === index));
      }
    },
    { rootMargin: '-45% 0px -45% 0px' }
  );
  document.querySelectorAll('[data-gallery-scene]').forEach((scene) => observer.observe(scene));
</script>

<style>
  .section-title {
    font-weight: 300;
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .gallery {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    margin-top: clamp(36px, 5vw, 64px);
  }

  .gallery-index {
    position: sticky;
    top: calc(4rem + 48px);
    align-self: start;
  }

  .gallery-index ol {
    display: grid;
    gap: 2px;
  }

  .gallery-index a {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding-block: 7px;
    font-size: 12.5px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground));
    transition: color 0.2s ease;
  }

  .gallery-index a::before {
    content: '';
    justify-self: center;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: hsl(var(--border));
    transition: background-color 0.2s ease;
  }

  .gallery-index a:hover {
    color: hsl(var(--foreground));
  }

  .gallery-index a.is-active {
    color: var(--gold);
  }

  .gallery-index a.is-active::before {
    background: var(--gold);
  }

  .scene,
  .others {
    scroll-margin-top: calc(4rem + 16px);
  }

  .scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    min-height: min(80vh, 760px);
    padding-block: clamp(48px, 8vh, 96px);
  }

  .scene.reverse {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .scene.reverse .scene-figure {
    order: 2;
  }

  /* 背面の年号。輪郭線だけの細い数字を、画像よりゆっくり動かす */
  .scene-year {
    position: absolute;
    top: clamp(8px, 3vh, 32px);
    right: 0;
    z-index: 0;
    font-weight: 200;
    font-size: clamp(5rem, 13vw, 12rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--gold-dim) 60%, transparent);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  .scene.reverse .scene-year {
    right: auto;
    left: 0;
  }

  .scene-figure {
    position: relative;
    z-index: 1;
    overflow: hidden;
    aspect-ratio: 3360 / 1856;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
  }

  .scene-image {
    position: absolute;
    inset: -10% 0;
    will-change: transform;
  }

  .scene-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scene-caption {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 12px;
  }

  .scene-title {
    font-weight: 300;
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    line-height: 1.45;
    letter-spacing: 0.08em;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .kind i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .kind-personal i {
    background: var(--gold);
  }

  .kind-professional i {
    border: 1px solid hsl(var(--foreground));
  }

  .others {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .others-title {
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: hsl(var(--muted-foreground));
  }

  .other-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto 64px 16px;
    align-items: baseline;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid hsl(var(--border));
    font-size: 14.5px;
  }

  .others li:first-child .other-row {
    border-top: 1px solid hsl(var(--border));
  }

  .other-no,
  .other-date {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .other-kind {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }

  .other-arrow {
    color: hsl(var(--muted-foreground));
  }

  .other-row:hover .other-title,
  .other-row:hover .other-arrow {
    color: var(--gold);
  }

  @media (max-width: 860px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .gallery-index {
      display: none;
    }
    .scene,
    .scene.reverse {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-block: 40px;
    }
    .scene.reverse .scene-figure {
      order: 0;
    }
    .scene-year {
      top: 0;
      font-size: 4.6rem;
    }
    .other-row {
      grid-template-columns: 52px minmax(0, 1fr) 16px;
    }
    .other-kind,
    .other-date {
      display: none;
    }
  }
</style>
