---
import MetricRow from '@/components/common/MetricRow.astro';
import SectionLabel from '@/components/common/SectionLabel.astro';
import { ImpactLegend } from '@/components/works';
import { homepageCopy } from '@/data/homepage';
import type { Highlight } from '@/data/highlights';

interface Props {
  highlights: Highlight[];
}

const { highlights } = Astro.props;
const { about } = homepageCopy;
---

<section id="about" class="relative scroll-mt-16 border-b py-20 md:py-36" aria-labelledby="about-title">
  <div class="container mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 md:gap-16 lg:px-8">
    <div class="grid items-center gap-12 md:grid-cols-[1.25fr_1fr] md:gap-20">
      <div class="grid justify-items-start gap-7">
        <SectionLabel text={about.label} />
        <h2 id="about-title" class="section-title">
          {
            about.title.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line.map((phrase) => <span class="inline-block">{phrase}</span>)}
              </>
            ))
          }
        </h2>
        <p class="max-w-[34em] text-muted-foreground">{about.lead}</p>
      </div>
      <div class="order-first md:order-none">
        <div class="mx-auto aspect-square w-full max-w-[300px] md:max-w-[400px]" data-parallax="0.12">
          <canvas class="block h-full w-full" data-shippo aria-hidden="true"></canvas>
        </div>
      </div>
    </div>
    <div class="grid gap-6">
      <MetricRow
        items={highlights.map((item) => ({
          label: item.label,
          value: item.value,
          unit: item.unit,
          meta: item.meta,
          kind: item.kind,
          href: item.href,
        }))}
      />
      <ImpactLegend />
    </div>
  </div>
</section>

<script>
  import { mountShippoWindow } from '@/lib/canvas/patterns';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-shippo]').forEach((canvas) => mountShippoWindow(canvas));
</script>

<style>
  .section-title {
    font-weight: 300;
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    line-height: 1.6;
    letter-spacing: 0.08em;
  }
</style>
