---
import { LinearRotate } from '@/components/magicui/linear-rotate';
import { ThemeSwitch } from '@/components/common/ThemeSwitch';
import { homepageCopy } from '@/data/homepage';
---

<section class="relative min-h-screen overflow-hidden">
  <div class="absolute inset-0 z-0">
    <LinearRotate client:only="react" />
  </div>

  <div class="relative z-10 min-h-screen flex flex-col items-center justify-center gap-8 pb-16 text-center">
    <div>
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tighter">
        {homepageCopy.hero.title.part1}
        <br />
        <span class="aurora-gradient">
          {homepageCopy.hero.title.highlight}
        </span>
        {homepageCopy.hero.title.part2}
      </h1>
      <p class="text-xl md:text-2xl mb-8 text-foreground/80">
        {homepageCopy.hero.subtitle}
      </p>
    </div>

    <div>
      <ThemeSwitch client:load />
    </div>
  </div>
</section>
