---
import { LinearRotate } from '@/components/magicui/linear-rotate';
import { getHomepageCopy } from '@/data/homepage';
import { localePath } from '@/lib/i18n';

const homepageCopy = getHomepageCopy(Astro.currentLocale);
const worksHref = localePath('/works', Astro.currentLocale);
const aboutHref = localePath('/about', Astro.currentLocale);
---

<section class="relative min-h-screen overflow-hidden">
  <div class="absolute inset-0 z-0">
    <LinearRotate client:only="react" />
  </div>

  <div class="relative z-10 min-h-screen flex flex-col items-center justify-center gap-8 pb-16 text-center">
    <div>
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tighter">
        {homepageCopy.hero.title.part1}
        <br />
        <span class="aurora-gradient">
          {homepageCopy.hero.title.highlight}
        </span>
        {homepageCopy.hero.title.part2}
      </h1>
      <p class="text-xl md:text-2xl mb-8 text-foreground/80">
        {homepageCopy.hero.subtitle}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={worksHref}
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-base font-medium transition-all h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90"
      >
        {homepageCopy.hero.ctaPrimary}
      </a>
      <a
        href={aboutHref}
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-base font-medium transition-all h-11 px-8 border border-input bg-background/60 backdrop-blur-sm hover:bg-accent hover:text-accent-foreground"
      >
        {homepageCopy.hero.ctaSecondary}
      </a>
    </div>
  </div>
</section>
