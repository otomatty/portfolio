---
import SectionLabel from '@/components/common/SectionLabel.astro';
import { homepageCopy } from '@/data/homepage';
import { profile } from '@/data/profile';

const { contact } = homepageCopy;
---

<section
  id="contact"
  class="contact relative isolate scroll-mt-16 overflow-hidden py-24 md:py-44"
  aria-labelledby="contact-title"
  data-seigaiha
>
  <canvas class="seigaiha" aria-hidden="true" data-parallax="0.18"></canvas>
  <div class="container mx-auto grid max-w-6xl justify-items-start gap-7 px-4 sm:px-6 lg:px-8">
    <SectionLabel text={contact.label} />
    <h2 id="contact-title" class="contact-title">{contact.title}</h2>
    <p class="max-w-[40em] text-muted-foreground">{contact.description}</p>
    <div class="flex flex-wrap items-center gap-x-7 gap-y-4 pt-1.5">
      <a
        href="/contact"
        class="inline-flex min-h-12 items-center justify-center rounded-full border border-gold px-7 text-[14.5px] tracking-[0.08em] text-gold transition-colors hover:bg-gold hover:text-background"
      >
        {contact.form}
      </a>
      <div class="flex flex-wrap items-center gap-3">
        <span class="select-all text-sm tracking-[0.04em] break-all" data-email>{profile.email}</span>
        <button
          type="button"
          class="min-h-[34px] cursor-pointer rounded-full border px-3.5 text-xs tracking-[0.08em] text-muted-foreground transition-colors hover:border-gold hover:text-foreground"
          data-copy-email
          data-label-copied={contact.copied}
          data-label-selected={contact.selected}
        >
          {contact.copy}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountSeigaiha } from '@/lib/canvas/patterns';
  import { initCopyEmail } from '@/lib/copy-email';

  document.querySelectorAll<HTMLElement>('[data-seigaiha]').forEach((section) => {
    const canvas = section.querySelector<HTMLCanvasElement>('canvas.seigaiha');
    if (canvas) mountSeigaiha(canvas, section);

    initCopyEmail(section);
  });
</script>

<style>
  /* 上下に余白を持たせ、パララックスで動かしても端が見えないようにする */
  .seigaiha {
    position: absolute;
    inset: -18% 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 136%;
    -webkit-mask-image: linear-gradient(270deg, #000 0%, rgb(0 0 0 / 0.75) 30%, transparent 72%);
    mask-image: linear-gradient(270deg, #000 0%, rgb(0 0 0 / 0.75) 30%, transparent 72%);
    will-change: transform;
  }

  .contact-title {
    font-weight: 300;
    font-size: clamp(2.2rem, 5.4vw, 4rem);
    line-height: 1.3;
    letter-spacing: 0.14em;
  }

  @media (max-width: 860px) {
    .seigaiha {
      -webkit-mask-image: linear-gradient(0deg, #000 0%, rgb(0 0 0 / 0.6) 30%, transparent 62%);
      mask-image: linear-gradient(0deg, #000 0%, rgb(0 0 0 / 0.6) 30%, transparent 62%);
    }
  }
</style>
