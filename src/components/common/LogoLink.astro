---
const href = '/';
const labels = ['Saedgewell', 'セージウェル', 'Akimasa Sugai'];
---

<a href={href} class="logo-link" aria-label="Saedgewell">
  <span class="logo-text" aria-hidden="true">
    {labels.map((label) => (
      <span class="logo-text__item">{label}</span>
    ))}
  </span>
  <span class="sr-only">Saedgewell</span>
</a>

<style>
  .logo-link {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .logo-text {
    display: inline-grid;
    position: relative;
  }

  .logo-text__item {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.45em) rotateX(16deg) scale(0.96);
    filter: blur(6px);
    letter-spacing: 0.06em;
    transition: opacity 0.2s ease;
    will-change: opacity, transform, filter, letter-spacing;
  }

  .logo-text__item:first-child {
    opacity: 1;
    transform: translateY(0) rotateX(0) scale(1);
    filter: blur(0);
    letter-spacing: 0;
  }

  .logo-link:hover .logo-text__item,
  .logo-link:focus-visible .logo-text__item {
    animation: logoTextReveal 4.5s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
  }

  .logo-link:hover .logo-text__item:nth-child(1),
  .logo-link:focus-visible .logo-text__item:nth-child(1) {
    animation-delay: 0s;
  }

  .logo-link:hover .logo-text__item:nth-child(2),
  .logo-link:focus-visible .logo-text__item:nth-child(2) {
    animation-delay: 1s;
  }

  .logo-link:hover .logo-text__item:nth-child(3),
  .logo-link:focus-visible .logo-text__item:nth-child(3) {
    animation-delay: 2s;
  }

  @keyframes logoTextReveal {
    0% {
      opacity: 0;
      transform: translateY(0.5em) rotateX(18deg) scale(0.96);
      filter: blur(10px);
      letter-spacing: 0.08em;
    }
    12% {
      opacity: 1;
      transform: translateY(0) rotateX(0) scale(1);
      filter: blur(0);
      letter-spacing: 0;
    }
    38% {
      opacity: 1;
      transform: translateY(0) rotateX(0) scale(1.03);
      filter: blur(0);
      letter-spacing: 0;
    }
    58% {
      opacity: 0;
      transform: translateY(-0.35em) rotateX(-12deg) scale(0.98);
      filter: blur(8px);
      letter-spacing: -0.02em;
    }
    100% {
      opacity: 0;
      transform: translateY(-0.5em) rotateX(-16deg) scale(0.98);
      filter: blur(12px);
      letter-spacing: -0.04em;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
