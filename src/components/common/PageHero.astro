---
/**
 * 下層ページの見出し。右側（スマートフォンでは上）にページごとの作図を描く。
 * 図形は `src/lib/canvas/figures.ts` にあり、WebGPU が使えないときは Canvas 2D で描く。
 */
import SectionLabel from './SectionLabel.astro';
import type { PageFigure } from '@/lib/canvas/figures';

interface Props {
  label: string;
  title: string;
  description?: string;
  figure: PageFigure;
}

const { label, title, description, figure } = Astro.props;
---

<section class="page-hero" data-page-figure={figure} aria-labelledby="page-title">
  <canvas class="page-hero-canvas" aria-hidden="true"></canvas>
  <div class="page-hero-veil" aria-hidden="true"></div>

  <div class="page-hero-body container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="page-hero-inner" data-parallax-fade>
      <SectionLabel text={label} />
      <h1 id="page-title" class="page-hero-title">{title}</h1>
      {description && <p class="page-hero-lead">{description}</p>}
      {Astro.slots.has('default') && (
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pt-1">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>

<script>
  import { pageFigures, type PageFigure } from '@/lib/canvas/figures';
  import { mountVectorScene } from '@/lib/canvas/scene';

  // 文字を図形の下に置くのは、CSS で縦に積む幅（640px 未満）と揃える
  const narrow = window.matchMedia('(max-width: 639px)');

  document.querySelectorAll<HTMLElement>('[data-page-figure]').forEach((section) => {
    const canvas = section.querySelector<HTMLCanvasElement>('.page-hero-canvas');
    const build = pageFigures[section.dataset.pageFigure as PageFigure];
    if (canvas && build) mountVectorScene(section, canvas, build, { compact: () => narrow.matches });
  });
</script>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: clamp(400px, 60vh, 560px);
    border-bottom: 1px solid hsl(var(--border));
  }

  .page-hero-canvas {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 文字の下だけ図形を薄くして読みやすくする */
  .page-hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      hsl(var(--background)) 0%,
      hsl(var(--background)) 22%,
      hsl(var(--background) / 0.55) 46%,
      transparent 62%
    );
  }

  .page-hero-inner {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    max-width: 38rem;
    padding-block: 4rem;
    will-change: transform, opacity;
  }

  .page-hero-title {
    font-weight: 300;
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    line-height: 1.45;
    letter-spacing: 0.12em;
    word-break: auto-phrase;
  }

  .page-hero-lead {
    max-width: 34em;
    font-size: clamp(0.92rem, 1.05vw, 1rem);
    line-height: 2.05;
    color: hsl(var(--muted-foreground));
    line-break: strict;
    word-break: auto-phrase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-hero-inner > * {
      animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .page-hero-inner > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .page-hero-inner > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .page-hero-inner > :nth-child(4) {
      animation-delay: 0.24s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 639px) {
    .page-hero {
      align-items: end;
      min-height: 540px;
    }
    .page-hero-veil {
      background: linear-gradient(
        0deg,
        hsl(var(--background)) 0%,
        hsl(var(--background)) 34%,
        hsl(var(--background) / 0.6) 54%,
        transparent 70%
      );
    }
    .page-hero-inner {
      gap: 1.25rem;
      padding-block: 2rem 2.5rem;
    }
  }
</style>
