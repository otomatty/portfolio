---
import { Container } from './container';
import { getT, localePath } from '@/lib/i18n';
import { profile } from '@/data/profile';

const currentLocale = Astro.currentLocale;
const common = getT(currentLocale, 'common');
const footerCopy = common.footer;

const footerLinks = [
  {
    title: footerCopy.sections.about.title,
    items: [
      { label: footerCopy.sections.about.items.intro, href: localePath('/about', currentLocale) },
      { label: footerCopy.sections.about.items.career, href: localePath('/about/career', currentLocale) },
      { label: footerCopy.sections.about.items.skills, href: localePath('/about/skills', currentLocale) },
    ],
  },
  {
    title: footerCopy.sections.works.title,
    items: [
      { label: footerCopy.sections.works.items.company, href: localePath('/works/company', currentLocale) },
      { label: footerCopy.sections.works.items.freelance, href: localePath('/works/freelance', currentLocale) },
      { label: footerCopy.sections.works.items.personal, href: localePath('/works/personal', currentLocale) },
    ],
  },
  {
    title: footerCopy.sections.contact.title,
    items: [
      { label: footerCopy.sections.contact.items.contact, href: localePath('/contact', currentLocale) },
    ],
  },
];

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/otomatty',
    icon: 'github',
  },
  {
    label: 'Email',
    href: `mailto:${profile.email}`,
    icon: 'mail',
  },
];

const currentYear = new Date().getFullYear();
const privacyHref = localePath('/privacy-policy', currentLocale);
const termsHref = localePath('/terms', currentLocale);
---

<footer
  class="border-t bg-background/95 backdrop-blur-sm supports-[backdrop-filter]:bg-background/60"
>
  <Container className="py-12">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-3">
      {
        footerLinks.map((section) => (
          <div class="footer-section">
            <h3 class="mb-3 text-sm font-semibold">{section.title}</h3>
            <ul class="space-y-2">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row"
    >
      <div class="flex items-center space-x-2">
        {
          socialLinks.map(({ label, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="inline-flex items-center justify-center size-9 rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
            >
              {icon === 'github' && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {icon === 'twitter' && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {icon === 'linkedin' && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              )}
              {icon === 'mail' && (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              )}
            </a>
          ))
        }
      </div>

      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
        <nav class="flex gap-4 text-sm text-muted-foreground">
          <a
            href={privacyHref}
            class="hover:text-foreground transition-colors"
          >
            {footerCopy.legal.privacy}
          </a>
          <a href={termsHref} class="hover:text-foreground transition-colors">
            {footerCopy.legal.terms}
          </a>
        </nav>
        <p class="text-sm text-muted-foreground">
          &copy; {currentYear} Saedgewell. {footerCopy.copyright}
        </p>
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer-section {
    animation: fadeInUp 0.5s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
