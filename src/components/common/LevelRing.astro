---
/**
 * 習熟度（1〜4）を、4つに分けた円周で示す。到達した段階だけを金で描く。
 */
interface Props {
  level: number;
  size?: number;
}

const { level, size = 40 } = Astro.props;
const r = 17;
const circumference = 2 * Math.PI * r;
const quarter = circumference / 4;
const gap = 3;
---

<span class="level-ring" style={`width:${size}px;height:${size}px`}>
  <svg viewBox="0 0 40 40" aria-hidden="true">
    {[0, 1, 2, 3].map((k) => (
      <circle
        cx="20"
        cy="20"
        r={r}
        fill="none"
        stroke-width="1.2"
        class:list={[k < level ? 'on' : 'off']}
        stroke-dasharray={`${quarter - gap} ${circumference - quarter + gap}`}
        stroke-dashoffset={-(k * quarter) - gap / 2}
        transform="rotate(-90 20 20)"
      />
    ))}
  </svg>
  <span class="level-text">L{level}</span>
</span>

<style>
  .level-ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
  }

  .level-ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .on {
    stroke: var(--gold);
  }

  .off {
    stroke: hsl(var(--foreground) / 0.15);
  }

  .level-text {
    font-size: 11px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
</style>
