---
import { profile } from '@/data/profile';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const siteUrl = 'https://saedgewell.com';
const siteName = 'Saedgewell';
const authorName = profile.name.ja;
const defaultDescription =
  'スガイアキマサ / ポートフォリオ';
const faviconUrl = new URL('/images/favicon/favicon-32x32.png', siteUrl).toString();

const {
  title,
  description = defaultDescription,
  image,
  lang = Astro.currentLocale ?? 'ja',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image ? new URL(image, siteUrl).toString() : null;

const localeMap = {
  ja: 'ja-JP',
  en: 'en-US',
} as const;
const ogLocaleMap = {
  ja: 'ja_JP',
  en: 'en_US',
} as const;
const langKey = lang.split('-')[0];
const languageTag =
  localeMap[langKey as keyof typeof localeMap] ?? lang;
const ogLocale =
  ogLocaleMap[langKey as keyof typeof ogLocaleMap] ??
  lang.replace('-', '_');

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const defaultJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: languageTag,
    publisher: {
      '@id': personId,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: authorName,
    alternateName: profile.name.en,
    jobTitle: 'Product Engineer',
    url: siteUrl,
    image: imageUrl ?? faviconUrl,
    sameAs: [
      profile.socials.github,
    ],
  },
];
const structuredData = Array.isArray(jsonLd)
  ? [...defaultJsonLd, ...jsonLd]
  : jsonLd
  ? [...defaultJsonLd, jsonLd]
  : defaultJsonLd;
---

<!doctype html>
<html lang={languageTag} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 正のファビコン: favicon.ico を優先（Slack 等もこちらを使用） -->
    <link rel="icon" href="/images/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="keywords"
      content="Product Engineer,Web Development,Next.js,React,TypeScript,Portfolio"
    />

    <!-- Open Graph / Facebook (og:image なしでシンプルなプレビューに) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter (画像なしのときは summary で小さいプレビュー) -->
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:site" content="@saedgewell" />
    <meta name="twitter:creator" content="@saedgewell" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <meta name="theme-color" content="#0f172a" />

    <!-- Fonts (self-hosted) -->
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {langKey === 'ja' && (
      <link
        rel="preload"
        href="/fonts/noto-sans-jp.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    <!-- Theme initialization script -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme') || 'system';
        const systemDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;
        const isDark = theme === 'dark' || (theme === 'system' && systemDark);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.classList.toggle('light', !isDark);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <style is:global>
      @import '../styles/global.css';

      body {
        font-family: var(--font-sans);
      }

      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
