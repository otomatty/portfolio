---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, image, noindex, jsonLd } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  import { initParallax } from '@/lib/parallax';

  // `data-parallax` と `data-parallax-fade` はどのページでも使えるようにする
  initParallax();
</script>
