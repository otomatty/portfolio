---
import PageLayout from '@/layouts/PageLayout.astro';
import {
  Introduction,
  Achievements,
  AdditionalAchievements,
  CTASection,
} from '@/components/home';
import Hero from '@/components/home/Hero.astro';
import { getFeaturedWorks, getAllWorks, getHomeMetrics } from '@/data';
import { commonCopy } from '@/data/common';

const metrics = getHomeMetrics();
const featuredWorks = getFeaturedWorks();
const latestWorks = getAllWorks().slice(0, 6);
---

<PageLayout
  title={commonCopy.home.meta.title}
  description={commonCopy.home.meta.description}
>
  <div class="min-h-screen">
    <Hero />
    <Introduction metrics={metrics} client:visible />
    <Achievements works={featuredWorks} client:visible />
    <AdditionalAchievements works={latestWorks} client:visible />
    <CTASection client:visible />
  </div>
</PageLayout>
