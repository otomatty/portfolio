---
import PageLayout from '@/layouts/PageLayout.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import AboutSection from '@/components/home/AboutSection.astro';
import WorksGallery from '@/components/home/WorksGallery.astro';
import ProfileSection from '@/components/home/ProfileSection.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import { getAllWorks, getFeaturedWorks, getWorkNumbers, hasMeasuredImpact, sortByCategory } from '@/data/works';
import { getHomeHighlights } from '@/data/highlights';
import { commonCopy } from '@/data/common';

/** 展示室の後に一覧で並べる件数。実測の数値がある実績から、区分の順・新しい順に選ぶ */
const OTHERS_LIMIT = 6;

const highlights = getHomeHighlights();
const featuredWorks = getFeaturedWorks();
const otherWorks = sortByCategory(getAllWorks())
  .filter((work) => work.featured === undefined && hasMeasuredImpact(work))
  .slice(0, OTHERS_LIMIT);
const numbers = getWorkNumbers();
---

<PageLayout
  title={commonCopy.home.meta.title}
  description={commonCopy.home.meta.description}
>
  <HeroSection />
  <AboutSection highlights={highlights} />
  <WorksGallery featured={featuredWorks} others={otherWorks} numbers={numbers} />
  <ProfileSection />
  <ContactSection />
</PageLayout>
