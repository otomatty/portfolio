---
import PageLayout from '@/layouts/PageLayout.astro';
import {
  ClientGearBackground,
  Introduction,
  Achievements,
  AdditionalAchievements,
  CTASection,
} from '@/components/home';
import Hero from '@/components/home/Hero.astro';
import { getFeaturedWorks, getAllWorks, getHomeMetrics } from '@/data';

const metrics = getHomeMetrics();
const featuredWorks = getFeaturedWorks();
const publishedWorks = getAllWorks();
const limitedPublishedWorks = publishedWorks.slice(0, 6);
---

<PageLayout
  title="Saedgewell | 菅井 瑛正"
  description="菅井瑛正のホームページです"
>
  <div class="min-h-screen">
    <ClientGearBackground client:only="react" />
    <Hero />
    <Introduction metrics={metrics} client:visible />
    <Achievements works={featuredWorks} client:visible />
    <AdditionalAchievements works={limitedPublishedWorks} client:visible />
    <CTASection client:visible />
  </div>
</PageLayout>
