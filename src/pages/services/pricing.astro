---
import PageLayout from '@/layouts/PageLayout.astro';
import { Container, BasicHero, SectionTitle, BackLink } from '@/components/common';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { pricingPlans } from '@/data/services';
---

<PageLayout
  title="料金 | Saedgewell"
  description="サービスの料金プランについて説明します。"
>
  <BasicHero
    title="料金プラン"
    description="サービスの料金プランについて説明します。"
    client:load
  />

  <Container className="py-12 space-y-12">
    <BackLink href="/services" label="サービス一覧に戻る" client:load />

    <!-- Pricing Cards -->
    <section>
      <div class="grid gap-8 md:grid-cols-3">
        {pricingPlans.map((plan) => (
          <Card className={`h-full flex flex-col ${plan.highlighted ? 'border-primary shadow-lg' : ''}`}>
            {plan.highlighted && (
              <div class="bg-primary text-primary-foreground text-center py-2 text-sm font-medium">
                おすすめ
              </div>
            )}
            <CardHeader>
              <CardTitle>{plan.title}</CardTitle>
              <div class="mt-2">
                <span class="text-3xl font-bold">{plan.price}</span>
                {plan.period && (
                  <span class="text-muted-foreground">{plan.period}</span>
                )}
              </div>
            </CardHeader>
            <CardContent className="flex-1 flex flex-col">
              <p class="text-muted-foreground mb-6">{plan.description}</p>
              <ul class="space-y-3 flex-1">
                {plan.features.map((feature) => (
                  <li class="flex items-center gap-2 text-sm">
                    <span class="text-primary">✓</span>
                    {feature}
                  </li>
                ))}
              </ul>
              <div class="mt-6">
                <a
                  href="/contact"
                  class={`w-full inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all h-10 px-4 py-2 ${
                    plan.highlighted
                      ? 'bg-primary text-primary-foreground hover:bg-primary/90'
                      : 'border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground'
                  }`}
                >
                  お問い合わせ
                </a>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>
    </section>

    <!-- Notes -->
    <section class="py-8 -mx-4 px-4 bg-secondary/5 rounded-lg">
      <SectionTitle
        title="料金についての注意事項"
        subtitle=""
        client:load
      />
      <div class="prose prose-sm max-w-none dark:prose-invert">
        <ul>
          <li>上記の料金は目安です。プロジェクトの規模や要件によって変動します。</li>
          <li>初回のヒアリングは無料で承っております。</li>
          <li>お支払いは月末締め翌月末払い、または着手時50%・納品時50%でのお支払いとなります。</li>
          <li>長期契約の場合は割引がございます。詳しくはお問い合わせください。</li>
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center">
      <h2 class="text-xl font-bold mb-4">まずはお気軽にご相談ください</h2>
      <p class="text-muted-foreground mb-6">
        プロジェクトの内容をお伺いし、最適なプランをご提案いたします。
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a
          href="/services/faq"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all h-9 px-4 py-2 border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground"
        >
          よくある質問
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all h-9 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90"
        >
          お問い合わせ
        </a>
      </div>
    </section>
  </Container>
</PageLayout>
