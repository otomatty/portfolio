---
import PageLayout from '@/layouts/PageLayout.astro';
import { Container, BasicHero, BackLink } from '@/components/common';
import { faqItems } from '@/data/services';
import { FAQAccordion } from '@/components/sections/FAQAccordion';
---

<PageLayout
  title="FAQ | Saedgewell"
  description="よくある質問と回答"
>
  <BasicHero
    title="よくある質問"
    description="サービスに関するよくある質問と回答です。"
    client:load
  />

  <Container className="py-12 space-y-12">
    <BackLink href="/services" label="サービス一覧に戻る" />

    <!-- FAQ Accordion -->
    <section class="max-w-3xl mx-auto">
      <FAQAccordion items={faqItems} client:load />
    </section>

    <!-- CTA -->
    <section class="text-center py-8 -mx-4 px-4 bg-secondary/5 rounded-lg">
      <h2 class="text-xl font-bold mb-4">その他のご質問</h2>
      <p class="text-muted-foreground mb-6">
        ここに掲載されていないご質問がありましたら、お気軽にお問い合わせください。
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all h-9 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90"
      >
        お問い合わせ
      </a>
    </section>
  </Container>
</PageLayout>
