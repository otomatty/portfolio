---
import PageLayout from '@/layouts/PageLayout.astro';
import { Container, BasicHero, SectionTitle, BackLink } from '@/components/common';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { processes } from '@/data/services';
---

<PageLayout
  title="開発プロセス | Saedgewell"
  description="プロジェクトの進め方について説明します。"
>
  <BasicHero
    title="開発プロセス"
    description="プロジェクトの進め方について説明します。"
    client:load
  />

  <Container className="py-12 space-y-12">
    <BackLink href="/services" label="サービス一覧に戻る" client:load />

    <!-- Process Timeline -->
    <section>
      <div class="space-y-8">
        {processes.map((process, index) => (
          <div class="relative flex gap-6">
            {index < processes.length - 1 && (
              <div class="absolute left-6 top-16 bottom-0 w-0.5 bg-border"></div>
            )}
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-bold text-lg">
                {process.step}
              </div>
            </div>
            <Card className="flex-1">
              <CardHeader>
                <div class="flex items-center justify-between gap-4">
                  <CardTitle>{process.title}</CardTitle>
                  <span class="text-sm text-muted-foreground bg-secondary px-3 py-1 rounded-full">
                    {process.duration}
                  </span>
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-muted-foreground">{process.description}</p>
              </CardContent>
            </Card>
          </div>
        ))}
      </div>
    </section>

    <!-- Key Points -->
    <section class="py-12 -mx-4 px-4 bg-secondary/5 rounded-lg">
      <SectionTitle
        title="大切にしていること"
        subtitle="プロジェクト進行において重視するポイント"
        client:load
      />
      <div class="grid gap-6 md:grid-cols-3">
        <Card>
          <CardHeader>
            <CardTitle>コミュニケーション</CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-muted-foreground">
              定期的なミーティングと進捗報告を通じて、認識のズレを防ぎます。
              Slack、Zoom、Notionなど、お客様のツールに合わせて対応します。
            </p>
          </CardContent>
        </Card>
        <Card>
          <CardHeader>
            <CardTitle>透明性</CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-muted-foreground">
              作業内容と進捗を可視化し、いつでも状況を把握できるようにします。
              課題やリスクも早期に共有し、一緒に解決策を検討します。
            </p>
          </CardContent>
        </Card>
        <Card>
          <CardHeader>
            <CardTitle>柔軟性</CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-muted-foreground">
              アジャイル開発の考え方を取り入れ、変化に柔軟に対応します。
              優先順位の変更や仕様の調整にも迅速に対応します。
            </p>
          </CardContent>
        </Card>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center">
      <p class="text-muted-foreground mb-6">
        開発プロセスについてご不明な点がありましたら、お気軽にお問い合わせください。
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all h-9 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90"
      >
        お問い合わせ
      </a>
    </section>
  </Container>
</PageLayout>
