---
import PageLayout from '@/layouts/PageLayout.astro';
import MetricRow from '@/components/common/MetricRow.astro';
import PageHero from '@/components/common/PageHero.astro';
import Section from '@/components/common/Section.astro';
import AboutCareer from '@/components/about/AboutCareer.astro';
import AboutCredentials from '@/components/about/AboutCredentials.astro';
import { ImpactLegend } from '@/components/works';
import { getCareerHighlights } from '@/data/highlights';

const highlights = getCareerHighlights();
---

<PageLayout
  title="Career | Saedgewell"
  description="これまでのキャリアと実績"
>
  <PageHero
    label="About / Career"
    title="経歴詳細"
    description="所属ごとに、担当した仕事と、それで何がどれだけ変わったかをまとめています。"
    figure="nested"
  />

  <Section id="highlights-title" label="Highlights" title="キャリアハイライト" description="実測した数値から、代表的なものを選んでいます。">
    <div class="grid gap-6">
      <MetricRow items={highlights} />
      <ImpactLegend />
    </div>
  </Section>
  <AboutCareer detailed title="職歴・経歴" />
  <AboutCredentials />
</PageLayout>
