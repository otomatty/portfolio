---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/common/PageHero.astro';
import { CareerHighlights } from '@/components/about/career/career-highlights';
import { CareerTimeline } from '@/components/about/career/career-timeline';
import { Education } from '@/components/about/career/education';
---

<PageLayout
  title="Career | Saedgewell"
  description="これまでのキャリアと実績"
>
  <PageHero
    label="About / Career"
    title="経歴詳細"
    description="エンジニアとしての経歴と実績についてご紹介します。"
    figure="nested"
  />

  <CareerHighlights client:visible />
  <CareerTimeline client:visible />
  <Education client:visible />
</PageLayout>
