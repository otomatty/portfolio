---
import PageLayout from '@/layouts/PageLayout.astro';
import MetricRow from '@/components/common/MetricRow.astro';
import PageHero from '@/components/common/PageHero.astro';
import Section from '@/components/common/Section.astro';
import AboutCareer from '@/components/about/AboutCareer.astro';
import AboutCredentials from '@/components/about/AboutCredentials.astro';
import { getCareerHighlights } from '@/data/profile';

const highlights = getCareerHighlights().map((item) => ({
  label: item.label,
  value: item.value,
  meta: item.description,
}));
---

<PageLayout
  title="Career | Saedgewell"
  description="これまでのキャリアと実績"
>
  <PageHero
    label="About / Career"
    title="経歴詳細"
    description="エンジニアとしての経歴と実績についてご紹介します。"
    figure="nested"
  />

  <Section id="highlights-title" label="Highlights" title="キャリアハイライト" description="これまでの主な実績です。">
    <MetricRow items={highlights} />
  </Section>
  <AboutCareer detailed title="職歴・経歴" />
  <AboutCredentials />
</PageLayout>
