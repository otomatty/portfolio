---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/common/PageHero.astro';
import { Motivation } from '@/components/about/story/motivation';
import { JourneyTimeline } from '@/components/about/story/journey-timeline';
import { Influences } from '@/components/about/story/influences';
import { Vision } from '@/components/about/story/vision';
---

<PageLayout
  title="Story | Saedgewell"
  description="エンジニアとしての歩みとビジョン"
>
  <PageHero
    label="About / Story"
    title="エンジニアへの道のり"
    description="プログラミングを始めたきっかけから現在に至るまでの道のりをご紹介します。"
    figure="spiral"
  />

  <Motivation client:visible />
  <JourneyTimeline client:visible />
  <Influences client:visible />
  <Vision client:visible />
</PageLayout>
