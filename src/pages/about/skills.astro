---
import PageLayout from '@/layouts/PageLayout.astro';
import { BasicHero } from '@/components/common';
import { SkillSummary } from '@/components/about/skills/skill-summary';
import { SkillCapabilities } from '@/components/about/skills/skill-capabilities';
import { SkillStack } from '@/components/about/skills/skill-stack';
import { SkillDevelopment } from '@/components/about/skills/skill-development';
---

<PageLayout
  title="Skills | Saedgewell"
  description="技術スキルと専門分野"
>
  <BasicHero
    title="スキル・専門領域"
    description="何ができて、どのような仕事を任せられるか。技術スタックと対応可能な業務についてご紹介します。"
    client:load
  />

  <SkillSummary client:load />
  <SkillCapabilities client:load />
  <SkillStack client:load />
  <SkillDevelopment client:load />
</PageLayout>
