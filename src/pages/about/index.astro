---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/common/PageHero.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ProfileSection from '@/components/home/ProfileSection.astro';
import AboutCareer from '@/components/about/AboutCareer.astro';
import AboutValues from '@/components/about/AboutValues.astro';
import AboutStack from '@/components/about/AboutStack.astro';
import AboutCredentials from '@/components/about/AboutCredentials.astro';
import AboutInterests from '@/components/about/AboutInterests.astro';
import { GithubContributions } from '@/components/about/github-contributions';
import { getGithubCalendarContributions } from '@/lib/github';
import { profile } from '@/data/profile';
import type { ContributionDay } from '@/types/github';

const githubUsername = import.meta.env.GITHUB_USERNAME;
const githubToken = import.meta.env.GITHUB_TOKEN;

let contributions: ContributionDay[] = [];
let showContributions = false;

if (githubUsername && githubToken) {
  try {
    contributions = await getGithubCalendarContributions(
      githubUsername,
      githubToken
    );
    showContributions = true;
  } catch (error) {
    console.error('Failed to fetch GitHub contributions:', error);
  }
}
---

<PageLayout
  title="About Me | Saedgewell"
  description="AI駆動開発の導入支援とAIを活用した開発を軸に、UI/UXからインフラまで幅広く手がけるエンジニアです。"
>
  <PageHero label="About" title="プロフィール" description={profile.headline} figure="seed">
    <a
      href="/contact"
      class="inline-flex min-h-12 items-center justify-center rounded-full border border-gold px-7 text-[14.5px] tracking-[0.08em] text-gold transition-colors hover:bg-gold hover:text-background"
    >
      お問い合わせ
    </a>
    <a
      href={profile.socials.github}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-3 text-[14.5px] tracking-[0.08em] transition-colors hover:text-gold"
    >
      GitHub
      <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">↗</span>
    </a>
  </PageHero>

  <ProfileSection cta={{ label: 'エンジニアへの道のり', href: '/about/story' }} />
  <AboutCareer />
  <AboutValues />
  <AboutStack />
  <AboutCredentials />
  <AboutInterests />

  {showContributions && (
    <section class="border-b py-20 md:py-28" aria-labelledby="github-title">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <SectionHeading id="github-title" label="GitHub" title="コントリビューション" />
        <GithubContributions contributions={contributions} client:visible />
      </div>
    </section>
  )}
</PageLayout>
