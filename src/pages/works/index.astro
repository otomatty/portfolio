---
import PageLayout from '@/layouts/PageLayout.astro';
import { Container } from '@/components/common';
import { WorksFilter, WorksHero } from '@/components/works';
import { getAllWorks, getAllTechnologies } from '@/data/works';

const works = getAllWorks();
const technologies = getAllTechnologies();
---

<PageLayout
  title="実績一覧 | Saedgewell"
  description="これまでの実績をご紹介します。"
>
  <WorksHero client:load />

  <Container className="py-12">
    <WorksFilter works={works} technologies={technologies} client:visible />
  </Container>
</PageLayout>
