---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import PillLink from '@/components/common/PillLink.astro';
import SectionLabel from '@/components/common/SectionLabel.astro';
import { ImpactBlock, ImpactCaption, ImpactValue } from '@/components/works';
import { kanjiNumerals } from '@/data/about';
import {
  WORK_CATEGORY_LABELS,
  formatImpactValue,
  formatWorkNumber,
  formatWorkPeriod,
  getAllWorks,
  getWorkNumbers,
} from '@/data/works';
import type { Work } from '@/types/works';

export function getStaticPaths() {
  return getAllWorks().map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props as { work: Work };

const siteUrl = 'https://saedgewell.com';
const FALLBACK_THUMBNAIL = '/images/works/default-thumbnail.webp';

const pageTitle = `${work.title} | Saedgewell`;
const pageDescription = work.goal ?? work.description;
const pageImage = work.thumbnail || FALLBACK_THUMBNAIL;
const pageUrl = new URL(`/works/${work.slug}`, siteUrl).toString();
const workLinks = [work.website_url, work.github_url].filter(Boolean);

const meta = [
  { label: '期間', value: formatWorkPeriod(work.period) },
  { label: '体制', value: work.team },
  { label: '役割', value: work.role },
  { label: '分野', value: work.industry },
].filter((item): item is { label: string; value: string } => Boolean(item.value));

const impacts = work.impacts ?? [];
// 前後を比べられる数値だけを「数値」の節に並べる
const comparisons = impacts.filter((impact) => impact.before);

// ある節にだけ漢数字を振る
const sections = [
  work.goal || work.challenges?.length ? 'goal' : null,
  work.approach?.length ? 'approach' : null,
  comparisons.length ? 'numbers' : null,
  'basis',
].filter((id): id is string => id !== null);
const numeral = (id: string) => kanjiNumerals[sections.indexOf(id)];

const barWidth = (bars: [number, number], i: 0 | 1) => `${(bars[i] / Math.max(...bars)) * 100}%`;

// 通し番号の前後の実績へつなぐ
const numbers = getWorkNumbers();
const number = numbers[work.slug];
const bySlug = Object.fromEntries(getAllWorks().map((item) => [item.slug, item]));
const slugAt = (n: number) => Object.keys(numbers).find((slug) => numbers[slug] === n);
const prevSlug = slugAt(number - 1);
const nextSlug = slugAt(number + 1);
const prev = prevSlug ? bySlug[prevSlug] : undefined;
const next = nextSlug ? bySlug[nextSlug] : undefined;
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: work.title,
  description: pageDescription,
  url: pageUrl,
  image: new URL(pageImage, siteUrl).toString(),
  dateCreated: work.period.start,
  author: {
    '@type': 'Person',
    name: '菅井瑛正',
    url: siteUrl,
  },
  ...(workLinks.length ? { sameAs: workLinks } : {}),
  inLanguage: 'ja-JP',
};
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  jsonLd={pageJsonLd}
>
  <article>
    <header class="detail-head border-b">
      <span class="detail-year" data-parallax="0.24" aria-hidden="true">{work.period.start.slice(0, 4)}</span>
      <div class="container relative mx-auto grid max-w-6xl justify-items-start gap-6 px-4 pt-12 pb-16 sm:px-6 md:pt-16 md:pb-24 lg:px-8">
        <a href="/works" class="group inline-flex items-center gap-2 text-[13px] tracking-[0.08em] text-muted-foreground transition-colors hover:text-gold">
          <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
          実績一覧
        </a>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <SectionLabel text={`${formatWorkNumber(number)} · ${WORK_CATEGORY_LABELS[work.category]}`} />
          {work.masked && (
            <span class="rounded-full border border-foreground/25 px-2.5 py-0.5 text-[11px] tracking-[0.08em] text-muted-foreground">NDA 配慮</span>
          )}
        </div>
        <h1 class="heading-thin text-[clamp(2rem,4.4vw,3.4rem)]">
          {work.title}
          {work.subtitle && <span class="mt-2 block text-[clamp(1rem,1.8vw,1.3rem)] text-muted-foreground">{work.subtitle}</span>}
        </h1>
        <p class="text-flow max-w-[40em] text-muted-foreground">{work.description}</p>
        {(work.website_url || work.github_url) && (
          <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pt-1">
            {work.website_url && <PillLink href={work.website_url} label="サイトを見る" external />}
            {work.github_url && (
              <a
                href={work.github_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[14.5px] tracking-[0.08em] transition-colors hover:text-gold"
              >
                ソースコード ↗
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="container mx-auto max-w-6xl px-4 pt-10 sm:px-6 md:pt-14 lg:px-8">
      <dl class="detail-meta">
        {meta.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    {work.thumbnail && (
      <div class="container mx-auto max-w-6xl px-4 pt-14 sm:px-6 md:pt-20 lg:px-8">
        <figure class="detail-figure">
          <div class="detail-image" data-parallax="-0.05">
            <Image
              src={work.thumbnail}
              alt={`${work.title} の画面`}
              width={1600}
              height={884}
              sizes="(min-width: 1152px) 1104px, 100vw"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>
    )}

    {impacts.length > 0 && (
      <section class="detail-section border-b" aria-labelledby="impacts-title">
        <div class="container mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:px-8">
          <h2 id="impacts-title" class="text-[12px] font-normal tracking-[0.24em] text-gold">成果</h2>
          <ul class="impact-grid">
            {impacts.map((impact) => (
              <li>
                <ImpactBlock impact={impact} size="lg" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {sections.includes('goal') && (
      <section class="detail-section border-b" aria-labelledby="goal-title">
        <div class="detail-grid container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="detail-heading">
            <span aria-hidden="true">{numeral('goal')}</span>
            <h2 id="goal-title">目指したこと</h2>
          </div>
          <div class="grid gap-8">
            {work.goal && <p class="text-[clamp(1rem,1.6vw,1.15rem)] font-light leading-[1.95] tracking-[0.04em]">{work.goal}</p>}
            {work.challenges && work.challenges.length > 0 && (
              <div class="grid gap-3">
                <p class="text-[11.5px] tracking-[0.14em] text-gold">始めたときの課題</p>
                <ul class="border-t">
                  {work.challenges.map((challenge) => (
                    <li class="border-b py-3.5 text-[14.5px] text-muted-foreground">{challenge}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {sections.includes('approach') && (
      <section class="detail-section border-b" aria-labelledby="approach-title">
        <div class="detail-grid container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="detail-heading">
            <span aria-hidden="true">{numeral('approach')}</span>
            <h2 id="approach-title">打ち手</h2>
          </div>
          <ol class="border-t">
            {work.approach?.map((step, i) => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 border-b py-4">
                <span class="text-gold" aria-hidden="true">{kanjiNumerals[i]}</span>
                <div class="grid gap-1">
                  <p class="text-[15px] leading-relaxed">{step.title}</p>
                  {step.detail && <p class="text-[13.5px] text-muted-foreground">{step.detail}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {sections.includes('numbers') && (
      <section class="detail-section border-b" aria-labelledby="numbers-title">
        <div class="detail-grid container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="detail-heading">
            <span aria-hidden="true">{numeral('numbers')}</span>
            <h2 id="numbers-title">数値</h2>
            <p>前と後を同じ物差しで比べています。</p>
          </div>
          <ul class="grid gap-10">
            {comparisons.map((impact) => (
              <li class="grid gap-3">
                <ImpactCaption impact={impact} className="text-[14px] text-foreground" />
                {impact.bars ? (
                  <div class="grid gap-2 text-[12.5px] text-muted-foreground tabular-nums">
                    <div class="bar-row">
                      <span>前</span>
                      <span class="bar"><span class="bar-fill is-before" style={{ width: barWidth(impact.bars, 0) }}></span></span>
                      <span class="text-right">{impact.before}</span>
                    </div>
                    <div class="bar-row">
                      <span>後</span>
                      <span class="bar"><span class="bar-fill" style={{ width: barWidth(impact.bars, 1) }}></span></span>
                      <span class="text-right text-foreground">{formatImpactValue(impact)}</span>
                    </div>
                  </div>
                ) : (
                  <ImpactValue impact={impact} />
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="detail-section" aria-labelledby="basis-title">
      <div class="detail-grid container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="detail-heading">
          <span aria-hidden="true">{numeral('basis')}</span>
          <h2 id="basis-title">{work.basis?.length ? '根拠と技術' : '技術'}</h2>
        </div>
        <div class="grid gap-8">
          {work.basis && work.basis.length > 0 && (
            <div class="overflow-x-auto">
              <table class="w-full min-w-[28rem] border-collapse text-[14px]">
                <thead>
                  <tr>
                    <th scope="col" class="basis-th">数値</th>
                    <th scope="col" class="basis-th">測り方</th>
                  </tr>
                </thead>
                <tbody>
                  {work.basis.map((item) => (
                    <tr>
                      <td class="border-b py-3 pr-4 align-top whitespace-nowrap">{item.label}</td>
                      <td class="border-b py-3 text-muted-foreground">{item.method}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-[14px] tracking-[0.04em]">
            {work.technologies.map((tech) => <li>{tech}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {(prev || next) && (
      <nav class="border-t" aria-label="前後の実績">
        <div class="container mx-auto grid max-w-6xl grid-cols-2 px-4 sm:px-6 lg:px-8">
          {prev ? (
            <a href={`/works/${prev.slug}`} class="pager group">
              <span class="pager-label"><span aria-hidden="true">←</span> {formatWorkNumber(number - 1)}</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : <span />}
          {next && (
            <a href={`/works/${next.slug}`} class="pager pager-next group">
              <span class="pager-label">{formatWorkNumber(number + 1)} <span aria-hidden="true">→</span></span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</PageLayout>

<style>
  .detail-head {
    position: relative;
    overflow: hidden;
  }

  /* 背面に開始年を輪郭だけの大きな数字で置き、本文より遅れて動かす */
  .detail-year {
    position: absolute;
    right: max(16px, calc((100vw - 72rem) / 2));
    bottom: -0.12em;
    font-weight: 200;
    font-size: clamp(6rem, 18vw, 15rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--gold-dim) 55%, transparent);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  .detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    width: 100%;
    border-block: 1px solid hsl(var(--border));
  }

  .detail-meta > div {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem 1.1rem 0;
  }

  .detail-meta > div + div {
    padding-left: 1.25rem;
    border-left: 1px solid hsl(var(--border));
  }

  .detail-meta dt {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    color: var(--gold);
  }

  .detail-meta dd {
    font-size: 14.5px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .detail-figure {
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
  }

  /* 枠より少し大きく描き、スクロールで枠の中を動かす */
  .detail-image {
    margin-block: -3%;
    will-change: transform;
  }

  .detail-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .detail-section {
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.5rem 2rem;
  }

  .impact-grid > li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--gold);
  }

  .detail-grid {
    display: grid;
    gap: 2rem;
  }

  .detail-heading {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
  }

  .detail-heading > span {
    font-weight: 200;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--gold);
  }

  .detail-heading h2 {
    font-weight: 300;
    font-size: 1.6rem;
    letter-spacing: 0.1em;
  }

  .detail-heading p {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
  }

  .bar-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 7rem;
    align-items: center;
    gap: 0.75rem;
  }

  .bar {
    display: block;
    height: 6px;
    background: hsl(var(--border));
  }

  .bar-fill {
    display: block;
    height: 100%;
    background: var(--gold);
  }

  .bar-fill.is-before {
    background: var(--gold-dim);
  }

  .basis-th {
    padding: 0.6rem 1rem 0.6rem 0;
    border-bottom: 1px solid hsl(var(--border));
    text-align: left;
    font-weight: 400;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--gold);
  }

  .pager {
    display: grid;
    gap: 0.6rem;
    padding-block: 2.2rem 2.6rem;
    transition: color 0.2s;
  }

  .pager:hover {
    color: var(--gold);
  }

  .pager-next {
    justify-items: end;
    text-align: right;
    padding-left: 1.5rem;
    border-left: 1px solid hsl(var(--border));
  }

  .pager-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .pager-title {
    font-weight: 300;
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    letter-spacing: 0.08em;
  }

  @media (min-width: 768px) {
    .detail-grid {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 4rem;
    }
  }

  @media (max-width: 639px) {
    .detail-meta > div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid hsl(var(--border));
    }
  }
</style>
