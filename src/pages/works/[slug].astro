---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import PillLink from '@/components/common/PillLink.astro';
import SectionLabel from '@/components/common/SectionLabel.astro';
import { WORK_KIND_LABELS, formatWorkNumber, getAllWorks, getWorkNumbers } from '@/data/works';
import type { Work } from '@/types/works';

export function getStaticPaths() {
  return getAllWorks().map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props as { work: Work };

const siteUrl = 'https://saedgewell.com';
const FALLBACK_THUMBNAIL = '/images/works/default-thumbnail.webp';

const categoryLabels: Record<Work['category'], string> = {
  company: '会社案件',
  freelance: 'フリーランス',
  personal: '個人開発',
};

const formatDate = (value?: string) => (value ? value.slice(0, 10).replaceAll('-', '.') : '-');
const formatSchemaDate = (value?: string) =>
  value ? value.slice(0, 10) : undefined;
const pageTitle = work ? `${work.title} | Saedgewell` : 'Work | Saedgewell';
const pageDescription = work?.description ?? '実績の詳細をご紹介します。';
const pageImage = work?.thumbnail || FALLBACK_THUMBNAIL;
const pageUrl = new URL(`/works/${work.slug}`, siteUrl).toString();
const workLinks = [work.website_url, work.github_url].filter(Boolean);

// 通し番号の前後の実績へつなぐ
const numbers = getWorkNumbers();
const number = numbers[work.slug];
const bySlug = Object.fromEntries(getAllWorks().map((item) => [item.slug, item]));
const slugAt = (n: number) => Object.keys(numbers).find((slug) => numbers[slug] === n);
const prevSlug = slugAt(number - 1);
const nextSlug = slugAt(number + 1);
const prev = prevSlug ? bySlug[prevSlug] : undefined;
const next = nextSlug ? bySlug[nextSlug] : undefined;
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: work.title,
  description: pageDescription,
  url: pageUrl,
  image: new URL(pageImage, siteUrl).toString(),
  datePublished: formatSchemaDate(work.created_at),
  dateModified: formatSchemaDate(work.updated_at),
  author: {
    '@type': 'Person',
    name: '菅井瑛正',
    url: siteUrl,
  },
  ...(workLinks.length ? { sameAs: workLinks } : {}),
  inLanguage: 'ja-JP',
};
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  jsonLd={pageJsonLd}
>
  <article>
    <header class="detail-head border-b">
      <span class="detail-year" data-parallax="0.24" aria-hidden="true">{work.created_at.slice(0, 4)}</span>
      <div class="container relative mx-auto grid max-w-6xl justify-items-start gap-6 px-4 pt-12 pb-16 sm:px-6 md:pt-16 md:pb-24 lg:px-8">
        <a href="/works" class="group inline-flex items-center gap-2 text-[13px] tracking-[0.08em] text-muted-foreground transition-colors hover:text-gold">
          <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
          実績一覧
        </a>
        <SectionLabel text={`${formatWorkNumber(number)} · ${WORK_KIND_LABELS[work.kind]}`} />
        <h1 class="heading-thin text-[clamp(2rem,4.4vw,3.4rem)]">{work.title}</h1>
        <p class="text-flow max-w-[40em] text-muted-foreground">{work.description}</p>
        {(work.website_url || work.github_url) && (
          <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pt-1">
            {work.website_url && <PillLink href={work.website_url} label="サイトを見る" external />}
            {work.github_url && (
              <a
                href={work.github_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[14.5px] tracking-[0.08em] transition-colors hover:text-gold"
              >
                ソースコード ↗
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="container mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20 lg:px-8">
      <figure class="detail-figure">
        <div class="detail-image" data-parallax="-0.05">
          <Image
            src={work.thumbnail || FALLBACK_THUMBNAIL}
            alt={`${work.title} の画面`}
            width={1600}
            height={884}
            sizes="(min-width: 1152px) 1104px, 100vw"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </figure>

      <dl class="detail-meta">
        <div>
          <dt>区分</dt>
          <dd>{categoryLabels[work.category]}</dd>
        </div>
        <div>
          <dt>公開</dt>
          <dd>{formatDate(work.created_at)}</dd>
        </div>
        <div>
          <dt>更新</dt>
          <dd>{formatDate(work.updated_at)}</dd>
        </div>
        {work.technologies.length > 0 && (
          <div class="detail-tech">
            <dt>技術</dt>
            <dd>
              <ul class="flex flex-wrap gap-x-5 gap-y-1">
                {work.technologies.map((tech) => <li>{tech}</li>)}
              </ul>
            </dd>
          </div>
        )}
      </dl>
    </div>

    {(prev || next) && (
      <nav class="border-t" aria-label="前後の実績">
        <div class="container mx-auto grid max-w-6xl grid-cols-2 px-4 sm:px-6 lg:px-8">
          {prev ? (
            <a href={`/works/${prev.slug}`} class="pager group">
              <span class="pager-label"><span aria-hidden="true">←</span> {formatWorkNumber(number - 1)}</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : <span />}
          {next && (
            <a href={`/works/${next.slug}`} class="pager pager-next group">
              <span class="pager-label">{formatWorkNumber(number + 1)} <span aria-hidden="true">→</span></span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</PageLayout>

<style>
  .detail-head {
    position: relative;
    overflow: hidden;
  }

  /* 背面に作成年を輪郭だけの大きな数字で置き、本文より遅れて動かす */
  .detail-year {
    position: absolute;
    right: max(16px, calc((100vw - 72rem) / 2));
    bottom: -0.12em;
    font-weight: 200;
    font-size: clamp(6rem, 18vw, 15rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--gold-dim) 55%, transparent);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  .detail-figure {
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
  }

  /* 枠より少し大きく描き、スクロールで枠の中を動かす */
  .detail-image {
    margin-block: -3%;
    will-change: transform;
  }

  .detail-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .detail-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid hsl(var(--border));
  }

  .detail-meta > div {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .detail-meta .detail-tech {
    grid-column: 1 / -1;
  }

  .detail-meta dt {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    color: var(--gold);
  }

  .detail-meta dd {
    font-size: 14.5px;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .pager {
    display: grid;
    gap: 0.6rem;
    padding-block: 2.2rem 2.6rem;
    transition: color 0.2s;
  }

  .pager:hover {
    color: var(--gold);
  }

  .pager-next {
    justify-items: end;
    text-align: right;
    padding-left: 1.5rem;
    border-left: 1px solid hsl(var(--border));
  }

  .pager-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .pager-title {
    font-weight: 300;
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    letter-spacing: 0.08em;
  }

  @media (min-width: 768px) {
    .detail-meta {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 2.2fr);
    }
    .detail-meta .detail-tech {
      grid-column: auto;
    }
    .detail-meta > div + div {
      padding-left: 1.5rem;
      border-left: 1px solid hsl(var(--border));
    }
  }

  @media (max-width: 767px) {
    .detail-meta > div:nth-child(2),
    .detail-meta > div:nth-child(3) {
      padding-left: 1rem;
      border-left: 1px solid hsl(var(--border));
    }
  }
</style>
