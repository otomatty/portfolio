---
import PageLayout from '@/layouts/PageLayout.astro';
import { Container } from '@/components/common';
import { WorksFilter, WorksHero } from '@/components/works';
import { getAllTechnologies, getAllWorks } from '@/data/works';

const works = getAllWorks();
const technologies = getAllTechnologies();
---

<PageLayout
  title="フリーランスの実績 | Saedgewell"
  description="これまでのフリーランスとしての実績をご紹介します。"
>
  <WorksHero client:load />

  <Container className="py-12">
    <WorksFilter
      works={works}
      technologies={technologies}
      initialCategory="freelance"
      client:load
    />
  </Container>
</PageLayout>
