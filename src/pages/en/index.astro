---
import PageLayout from '@/layouts/PageLayout.astro';
import {
  Introduction,
  Achievements,
  AdditionalAchievements,
  CTASection,
} from '@/components/home';
import Hero from '@/components/home/Hero.astro';
import { getFeaturedWorks, getAllWorks, getHomeMetrics } from '@/data';
import { getHomepageCopy } from '@/data/homepage';
import { getT } from '@/lib/i18n';

const locale = Astro.currentLocale;
const copy = getHomepageCopy(locale);
const common = getT(locale, 'common');

const metrics = getHomeMetrics();
const featuredWorks = getFeaturedWorks();
const publishedWorks = getAllWorks();
const limitedPublishedWorks = publishedWorks.slice(0, 6);
---

<PageLayout
  title={common.home.meta.title}
  description={common.home.meta.description}
>
  <div class="min-h-screen">
    <Hero />
    <Introduction metrics={metrics} copy={copy} client:visible />
    <Achievements works={featuredWorks} copy={copy} client:visible />
    <AdditionalAchievements
      works={limitedPublishedWorks}
      copy={copy}
      client:visible
    />
    <CTASection copy={copy} client:visible />
  </div>
</PageLayout>
