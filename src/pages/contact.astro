---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/common/PageHero.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import { kanjiNumerals } from '@/data/about';
import { homepageCopy } from '@/data/homepage';
import { profile } from '@/data/profile';

const { contact: copy } = homepageCopy;

const socials = [
  { name: 'GitHub', handle: '@otomatty', href: 'https://github.com/otomatty' },
  { name: 'X (Twitter)', handle: '@saedgewell', href: 'https://twitter.com/saedgewell' },
  { name: 'LinkedIn', handle: 'saedgewell', href: 'https://linkedin.com/in/saedgewell' },
];

const steps = [
  { title: 'ご相談内容の共有', description: '課題、目的、スケジュール感をお知らせください。' },
  { title: 'ヒアリング・整理', description: '目的や要件を整理し、最適な進め方を検討します。' },
  { title: 'ご提案・次のアクション', description: '進め方やスケジュールなど、具体的なご提案をお返しします。' },
];

const topics = ['Webアプリ開発', 'プロトタイプ設計', 'UI/UX改善', '技術選定の相談', '既存システム改善'];
---

<PageLayout
  title="お問い合わせ | Saedgewell"
  description="ご相談・ご質問はこちらからお気軽にご連絡ください。"
>
  <PageHero
    label="Contact"
    title="お問い合わせ"
    description="ご相談・ご質問はこちらからお気軽にご連絡ください。"
    figure="vesica"
  />

  <section class="border-b py-20 md:py-28" aria-labelledby="mail-title" data-email-copy>
    <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        id="mail-title"
        label="Mail"
        title="メールでのご連絡"
        description="ご相談内容・ご希望のスケジュールなどをお送りください。通常、1〜2営業日以内にご返信いたします。"
      />
      <p class="mail-address" data-email>{profile.email}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-gold px-7 text-[14.5px] tracking-[0.08em] text-gold transition-colors hover:bg-gold hover:text-background"
        >
          メールを送る
        </a>
        <button
          type="button"
          class="min-h-[34px] cursor-pointer rounded-full border px-3.5 text-xs tracking-[0.08em] text-muted-foreground transition-colors hover:border-gold hover:text-foreground"
          data-copy-email
          data-label-copied={copy.copied}
          data-label-selected={copy.selected}
        >
          {copy.copy}
        </button>
      </div>
      <p class="mt-8 text-[12.5px] tracking-[0.08em] text-muted-foreground">返信目安 1〜2営業日 · 日本語対応</p>
    </div>
  </section>

  <section class="border-b py-20 md:py-28" aria-labelledby="social-title">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        id="social-title"
        label="Social"
        title="SNSでのご連絡"
        description="SNSのダイレクトメッセージからもご連絡いただけます。"
      />
      <ul class="border-b">
        {socials.map((social) => (
          <li class="border-t">
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="social-row group">
              <span class="text-[12.5px] tracking-[0.12em] text-muted-foreground">{social.name}</span>
              <span class="tracking-[0.06em] transition-colors group-hover:text-gold">{social.handle}</span>
              <span class="text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-gold" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-b py-20 md:py-28" aria-labelledby="flow-title">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading id="flow-title" label="Process" title="ご相談の流れ" />
      <ol class="grid grid-cols-[minmax(0,1fr)] gap-x-10 gap-y-12 md:grid-cols-3">
        {steps.map((step, i) => (
          <li class="grid content-start gap-3 border-t pt-6">
            <span class="text-[15px] font-light text-gold" aria-hidden="true">{kanjiNumerals[i]}</span>
            <h3 class="text-[17px] font-normal tracking-[0.08em]">{step.title}</h3>
            <p class="text-flow text-[14px] text-muted-foreground">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 md:py-28" aria-labelledby="topics-title">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        id="topics-title"
        label="Topics"
        title="ご相談内容の例"
        description="下記のようなご相談に対応しています。"
      />
      <ul class="flex flex-wrap gap-2.5">
        {topics.map((topic) => (
          <li class="rounded-full border border-foreground/15 px-4 py-1.5 text-[13px] tracking-[0.06em]">{topic}</li>
        ))}
      </ul>
      <p class="mt-14 text-[13px] tracking-[0.04em] text-muted-foreground">
        現在はフォーム送信を準備中のため、メールまたはSNSでご連絡ください。
      </p>
    </div>
  </section>
</PageLayout>

<script>
  import { initCopyEmail } from '@/lib/copy-email';

  document.querySelectorAll<HTMLElement>('[data-email-copy]').forEach((section) => initCopyEmail(section));
</script>

<style>
  .mail-address {
    font-weight: 300;
    font-size: clamp(1.25rem, 3.4vw, 2.4rem);
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .social-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.35rem;
  }

  @media (max-width: 480px) {
    .social-row {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.25rem;
    }
    .social-row > :first-child {
      grid-column: 1 / -1;
    }
  }
</style>
