---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/common/PageHero.astro';
import MoreLink from '@/components/common/MoreLink.astro';
---

<PageLayout
  title="ページが見つかりません | Saedgewell"
  description="お探しのページは存在しないか、移動した可能性があります。"
  noindex={true}
>
  <!-- 円鎖の円を1つだけ欠けさせ、見つからないページを表す -->
  <div class="not-found">
    <PageHero
      label="404 · Not Found"
      title="ページが見つかりません"
      description="お探しのページは存在しないか、移動した可能性があります。"
      figure="gap"
    >
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-full border border-gold px-7 text-[14.5px] tracking-[0.08em] text-gold transition-colors hover:bg-gold hover:text-background"
      >
        ホームに戻る
      </a>
      <MoreLink href="/works" label="実績一覧" />
    </PageHero>
  </div>
</PageLayout>

<style>
  /* フッターまでの間を空けず、見出しだけで画面を満たす */
  .not-found :global(.page-hero) {
    min-height: calc(100svh - 4rem);
    border-bottom: 0;
  }
</style>
